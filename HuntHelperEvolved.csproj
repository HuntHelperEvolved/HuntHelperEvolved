<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- Portable debug metadata must not disclose the developer's filesystem. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/HuntHelperEvolved</PathMap>
    <Deterministic>true</Deterministic>
    <Authors>MusicManBowls, kihtli</Authors>
    <Company></Company>
    <Version>0.6.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Hunt tracking for FFXIV. Scout and share trains, preview Discord reports with respawn summaries, track S/A-rank windows and live marks, map spawn points, pool trigger-mob kills and keep lifetime hunt tallies. Includes optional Lifestream travel and an Umbra train widget.</Description>
    <PackageProjectUrl></PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Train/Presets/RouteCatalog.json" LogicalName="TrainPresets.RouteCatalog.json" />
    <EmbeddedResource Include="Sync/SpawnConditions.json" LogicalName="HuntHelperEvolved.Sync.SpawnConditions.json" />
    <Compile Remove="tests/**/*.cs" />
    <!-- Used only by HuntMapOverlay, for drawing markers on the in-game map. -->
    <PackageReference Include="KamiToolKit" Version="2.0.23" />

    <!-- Spoken mark announcements, the same reference Hunt Helper uses for
         them. Windows-only at runtime; MarkNotifier catches that and says so
         rather than letting it break the other two notification channels. -->
    <PackageReference Include="System.Speech" Version="9.0.3" />
  </ItemGroup>
</Project>
